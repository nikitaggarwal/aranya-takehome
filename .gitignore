# Secrets — never commit
*.pem
*.key
id_rsa
id_ed25519
**/private_key*
**/secret*
kubeconfig
kubeconfig.yaml
admin.conf
*.kubeconfig
# Bare `key` at the repo root — the candidate-issued SSH private key gets dropped
# here while working. *.key wouldn't catch a file with no extension.
/key
/key.*

# Internal verification / scratch — not part of the deliverable.
VERIFY.md

# Encrypted credentials bundle — delivered as email attachment, not via the repo.
# Even though it's encrypted, no reason to publish it.
*.gpg
*.tar.gz.gpg

# Kubespray writes various secrets (kubeadm cert keys, etc.) into <inventory>/credentials/
inventory/credentials/
*.creds

# Python virtual env (kubespray deps live here)
venv/
.venv/

# Kubespray clone — pulled fresh per the runbook, not vendored
kubespray/

# macOS noise
.DS_Store

# Editor noise
.vscode/
.idea/
*.swp
